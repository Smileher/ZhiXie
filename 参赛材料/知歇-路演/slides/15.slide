<Slide style={{ width: 1280, height: 720, background: '#0B1220', padding: '20px 64px' }}>
    <Box style={{ height: 124, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between', paddingBottom: 16 }}>
        <Box style={{ flexDirection: 'column', gap: 4 }}>
            <Text style={{ fontSize: 46, fontWeight: 'bold', color: '#E8EEF7' }}>一个人 + AI 助手，怎么配合</Text>
            <Text style={{ fontSize: 28, color: '#E8EEF7', opacity: 0.6, letterSpacing: 1 }}>想法和结构是我定的，AI 帮忙写代码和文案</Text>
        </Box>
        <Text style={{ fontSize: 22, fontFamily: 'Consolas', color: '#4FE0B0', opacity: 0.8 }}>AI 开发</Text>
    </Box>
    <Box style={{ height: 476, flexDirection: 'column', gap: 18 }}>
        <Box style={{ flexDirection: 'row', gap: 28 }}>
            <Box style={{ flex: 1, height: 360, flexDirection: 'column', gap: 16, padding: 26, background: 'rgba(79,224,176,0.08)', border: '1px solid rgba(79,224,176,0.35)', borderRadius: 14 }}>
                <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#4FE0B0' }}>我负责</Text>
                <Box style={{ height: 3, width: 80, background: 'linear-gradient(135deg, #4FE0B0 0%, #2E9E8F 100%)', borderRadius: 2 }} />
                <Text style={{ fontSize: 28, color: '#E8EEF7', opacity: 0.85, lineHeight: 1.5 }}>定需求：这个软件到底要解决什么。</Text>
                <Text style={{ fontSize: 28, color: '#E8EEF7', opacity: 0.85, lineHeight: 1.5 }}>定结构：分几层、数据怎么放。</Text>
                <Text style={{ fontSize: 28, color: '#E8EEF7', opacity: 0.85, lineHeight: 1.5 }}>定规矩：哪些字段合法、不合法怎么办。</Text>
                <Text style={{ fontSize: 28, color: '#E8EEF7', opacity: 0.85, lineHeight: 1.5 }}>定测试：138 项检查的题目是我出的。</Text>
            </Box>
            <Box style={{ flex: 1, height: 360, flexDirection: 'column', gap: 16, padding: 26, background: 'rgba(232,238,247,0.04)', border: '1px solid rgba(232,238,247,0.10)', borderRadius: 14 }}>
                <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#E8EEF7' }}>AI 负责</Text>
                <Box style={{ height: 3, width: 80, background: 'linear-gradient(135deg, #4FE0B0 0%, #2E9E8F 100%)', borderRadius: 2 }} />
                <Text style={{ fontSize: 28, color: '#E8EEF7', opacity: 0.8, lineHeight: 1.5 }}>写跨平台的实现代码。</Text>
                <Text style={{ fontSize: 28, color: '#E8EEF7', opacity: 0.8, lineHeight: 1.5 }}>补两个系统的差异细节。</Text>
                <Text style={{ fontSize: 28, color: '#E8EEF7', opacity: 0.8, lineHeight: 1.5 }}>打磨界面与提示文案。</Text>
                <Text style={{ fontSize: 28, color: '#E8EEF7', opacity: 0.8, lineHeight: 1.5 }}>出错时一起查原因、给改法。</Text>
            </Box>
        </Box>
        <Box style={{ padding: '18px 24px', background: 'rgba(79,224,176,0.10)', borderRadius: 12 }}>
            <Text style={{ fontSize: 28, color: '#E8EEF7', lineHeight: 1.5 }}>AI 写出来的每一行，我都逐条看过；能不能留下，由<span style={{ color: '#4FE0B0', fontWeight: 'bold' }}>测试说了算</span>。</Text>
        </Box>
    </Box>
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 22, color: '#E8EEF7', opacity: 0.45 }}>知歇 ZhiXie · V1.0.0</Text>
        <Text style={{ fontSize: 22, fontFamily: 'Consolas', color: '#E8EEF7', opacity: 0.45 }}>15 / 30</Text>
    </Box>
</Slide>
