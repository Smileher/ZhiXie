<Slide style={{ width: 1280, height: 720, background: '#0B1220', padding: '20px 64px' }}>
    <Box style={{ height: 100, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between', paddingBottom: 18 }}>
        <Box style={{ flexDirection: 'column', gap: 6 }}>
            <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#E8EEF7' }}>到点了，会怎么样</Text>
            <Text style={{ fontSize: 16, color: '#E8EEF7', opacity: 0.55, letterSpacing: 1 }}>不是在角落弹个小通知，是整屏挡一下</Text>
        </Box>
        <Text style={{ fontSize: 14, fontFamily: 'Consolas', color: '#4FE0B0', opacity: 0.8 }}>核心体验</Text>
    </Box>
    <Box style={{ height: 500, flexDirection: 'row', gap: 28 }}>
        <Box style={{ width: 640, height: 460, flexDirection: 'column', justifyContent: 'center', alignItems: 'center', gap: 12, background: 'rgba(79,224,176,0.05)', border: '2px dashed rgba(79,224,176,0.55)', borderRadius: 14 }}>
            <Text style={{ fontSize: 13, fontFamily: 'Consolas', color: '#4FE0B0', letterSpacing: 1 }}>截图 ⑨</Text>
            <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#E8EEF7', textAlign: 'center' }}>全屏休息弹窗</Text>
            <Text style={{ fontSize: 14, color: '#E8EEF7', opacity: 0.5, textAlign: 'center', lineHeight: 1.7 }}>建议画面：底图 + 正中间那句提示语<br />+ 「稍后提醒」按钮</Text>
        </Box>
        <Box style={{ flex: 1, flexDirection: 'column', gap: 14 }}>
            <Box style={{ height: 96, flexDirection: 'column', justifyContent: 'center', gap: 6, padding: '0 20px', background: 'rgba(232,238,247,0.04)', border: '1px solid rgba(232,238,247,0.10)', borderRadius: 10 }}>
                <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#4FE0B0' }}>弹的是什么</Text>
                <Text style={{ fontSize: 15, color: '#E8EEF7', opacity: 0.72, lineHeight: 1.5 }}>正中间是你自己写的那句话；底图、配色、字的大小都能换，改的时候能实时预览。</Text>
            </Box>
            <Box style={{ height: 96, flexDirection: 'column', justifyContent: 'center', gap: 6, padding: '0 20px', background: 'rgba(232,238,247,0.04)', border: '1px solid rgba(232,238,247,0.10)', borderRadius: 10 }}>
                <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#4FE0B0' }}>两个选择</Text>
                <Text style={{ fontSize: 15, color: '#E8EEF7', opacity: 0.72, lineHeight: 1.5 }}>「稍后提醒」推迟一会儿，或者直接结束这次休息。</Text>
            </Box>
            <Box style={{ height: 112, flexDirection: 'column', justifyContent: 'center', gap: 6, padding: '0 20px', background: 'rgba(79,224,176,0.12)', border: '1px solid #4FE0B0', borderRadius: 10 }}>
                <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#4FE0B0' }}>要锁屏 / 关机时，留 60 秒反悔</Text>
                <Text style={{ fontSize: 15, color: '#E8EEF7', opacity: 0.85, lineHeight: 1.5 }}>先倒计时 60 秒，这期间随时能点掉；真要关机也来得及取消。执行失败了弹窗会留着让你重试。</Text>
            </Box>
            <Box style={{ height: 120, flexDirection: 'column', justifyContent: 'center', alignItems: 'center', gap: 6, background: 'rgba(79,224,176,0.05)', border: '2px dashed rgba(79,224,176,0.55)', borderRadius: 10 }}>
                <Text style={{ fontSize: 13, fontFamily: 'Consolas', color: '#4FE0B0', letterSpacing: 1 }}>截图 ⑩</Text>
                <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#E8EEF7', textAlign: 'center' }}>弹窗上的倒计时</Text>
                <Text style={{ fontSize: 12, color: '#E8EEF7', opacity: 0.5, textAlign: 'center', lineHeight: 1.5 }}>建议画面：附加锁屏或关机时，<br />右下角的 60 秒倒计时</Text>
            </Box>
        </Box>
    </Box>
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#E8EEF7', opacity: 0.42 }}>知歇 ZhiXie · V1.0.0</Text>
        <Text style={{ fontSize: 14, fontFamily: 'Consolas', color: '#E8EEF7', opacity: 0.42 }}>10 / 18</Text>
    </Box>
</Slide>
