            <Box style={{ height: 100, flexDirection: 'column', justifyContent: 'center', gap: 8, padding: '0 22px', background: 'rgba(232,238,247,0.04)', border: '1px solid rgba(232,238,247,0.10)', borderRadius: 12 }}>
