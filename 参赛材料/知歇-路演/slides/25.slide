        <Text style={{ fontSize: 22, fontFamily: 'Consolas', color: '#4FE0B0', opacity: 0.8 }}>成品演示</Text>
    </Box>
    <Box style={{ height: 476, flexDirection: 'column', gap: 18 }}>
        <Box style={{ flexDirection: 'row', gap: 28 }}>
            <Box style={{ flex: 1, height: 300, flexDirection: 'column', justifyContent: 'center', alignItems: 'center', gap: 10, background: 'rgba(79,224,176,0.05)', border: '2px dashed rgba(79,224,176,0.55)', borderRadius: 14, padding: '0 18px' }}>
                <Text style={{ fontSize: 22, fontFamily: 'Consolas', color: '#4FE0B0', letterSpacing: 1 }}>截图 ⑪</Text>
                <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#E8EEF7', textAlign: 'center' }}>休息节律页</Text>
                <Text style={{ fontSize: 22, color: '#E8EEF7', opacity: 0.5, textAlign: 'center', lineHeight: 1.6 }}>建议画面：间隔设置<br />+ 本轮进度条</Text>
            </Box>
            <Box style={{ flex: 1, height: 300, flexDirection: 'column', justifyContent: 'center', alignItems: 'center', gap: 10, background: 'rgba(79,224,176,0.05)', border: '2px dashed rgba(79,224,176,0.55)', borderRadius: 14, padding: '0 18px' }}>
                <Text style={{ fontSize: 22, fontFamily: 'Consolas', color: '#4FE0B0', letterSpacing: 1 }}>截图 ⑫</Text>
                <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#E8EEF7', textAlign: 'center' }}>休息建议卡片</Text>
                <Text style={{ fontSize: 22, color: '#E8EEF7', opacity: 0.5, textAlign: 'center', lineHeight: 1.6 }}>建议画面：点「换个建议」后<br />出现的那一条建议</Text>
            </Box>
        </Box>
        <Box style={{ flexDirection: 'row', gap: 24 }}>
            <Box style={{ flex: 1, height: 130, flexDirection: 'column', justifyContent: 'center', gap: 8, padding: '0 22px', background: 'rgba(232,238,247,0.04)', border: '1px solid rgba(232,238,247,0.10)', borderRadius: 12 }}>
                <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#4FE0B0' }}>休息节律：到点就提醒</Text>
