<Slide style={{ width: 1280, height: 720, background: '#0B1220', padding: '20px 64px' }}>
    <Box style={{ height: 100, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between', paddingBottom: 18 }}>
        <Box style={{ flexDirection: 'column', gap: 6 }}>
            <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#E8EEF7' }}>已经做完：能下载、能装、能用</Text>
            <Text style={{ fontSize: 16, color: '#E8EEF7', opacity: 0.55, letterSpacing: 1 }}>不是只有几张效果图的项目</Text>
        </Box>
        <Text style={{ fontSize: 14, fontFamily: 'Consolas', color: '#4FE0B0', opacity: 0.8 }}>完成度</Text>
    </Box>
    <Box style={{ height: 500, flexDirection: 'row', gap: 48 }}>
        <Box style={{ width: 460, flexDirection: 'column', justifyContent: 'center' }}>
            <Text style={{ fontSize: 150, fontWeight: 'bold', fontFamily: 'Consolas', color: '#4FE0B0', lineHeight: 1 }}>138</Text>
            <Text style={{ fontSize: 26, color: '#E8EEF7', marginTop: 12 }}>项自动检查，全部通过</Text>
            <Text style={{ fontSize: 17, color: '#E8EEF7', opacity: 0.6, marginTop: 6, lineHeight: 1.5 }}>每改一次代码就自动跑一遍，<br />有一项不过，这次改动就不算完。</Text>
            <Box style={{ height: 3, width: 96, background: 'linear-gradient(135deg, #4FE0B0 0%, #2E9E8F 100%)', borderRadius: 2, marginTop: 22 }} />
            <Text style={{ fontSize: 16, color: '#E8EEF7', opacity: 0.62, lineHeight: 1.6, marginTop: 22 }}>也就是说，刚才演示的每一步都不是"今天运气好"，而是每次跑都一样。</Text>
        </Box>
        <Box style={{ flex: 1, flexDirection: 'column', gap: 12, justifyContent: 'center' }}>
            <Box style={{ height: 62, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 22px', background: 'rgba(232,238,247,0.05)', borderRadius: 10 }}>
                <Text style={{ fontSize: 18, color: '#E8EEF7' }}>界面部分的检查</Text>
                <Text style={{ fontSize: 22, fontWeight: 'bold', fontFamily: 'Consolas', color: '#4FE0B0' }}>77 项</Text>
            </Box>
            <Box style={{ height: 62, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 22px', background: 'rgba(232,238,247,0.05)', borderRadius: 10 }}>
                <Text style={{ fontSize: 18, color: '#E8EEF7' }}>核心逻辑部分的检查</Text>
                <Text style={{ fontSize: 22, fontWeight: 'bold', fontFamily: 'Consolas', color: '#4FE0B0' }}>61 项</Text>
            </Box>
            <Box style={{ height: 62, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 22px', background: 'rgba(232,238,247,0.05)', borderRadius: 10 }}>
                <Text style={{ fontSize: 18, color: '#E8EEF7' }}>通过率</Text>
                <Text style={{ fontSize: 22, fontWeight: 'bold', fontFamily: 'Consolas', color: '#4FE0B0' }}>100%</Text>
            </Box>
            <Box style={{ height: 130, flexDirection: 'column', justifyContent: 'center', alignItems: 'center', gap: 6, background: 'rgba(79,224,176,0.05)', border: '2px dashed rgba(79,224,176,0.55)', borderRadius: 10 }}>
                <Text style={{ fontSize: 13, fontFamily: 'Consolas', color: '#4FE0B0', letterSpacing: 1 }}>截图 ⑮</Text>
                <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#E8EEF7', textAlign: 'center' }}>官网下载页</Text>
                <Text style={{ fontSize: 12, color: '#E8EEF7', opacity: 0.5, textAlign: 'center', lineHeight: 1.5 }}>建议画面：Windows 与 macOS<br />两个下载入口同框</Text>
            </Box>
            <Box style={{ flexDirection: 'row', gap: 10 }}>
                <Box style={{ flex: 1, padding: '10px 6px', background: 'rgba(79,224,176,0.10)', borderRadius: 8, alignItems: 'center' }}>
                    <Text style={{ fontSize: 14, color: '#E8EEF7', opacity: 0.88, textAlign: 'center' }}>两个平台都能装</Text>
                </Box>
                <Box style={{ flex: 1, padding: '10px 6px', background: 'rgba(79,224,176,0.10)', borderRadius: 8, alignItems: 'center' }}>
                    <Text style={{ fontSize: 14, color: '#E8EEF7', opacity: 0.88, textAlign: 'center' }}>官网可直接下载</Text>
                </Box>
                <Box style={{ flex: 1, padding: '10px 6px', background: 'rgba(79,224,176,0.10)', borderRadius: 8, alignItems: 'center' }}>
                    <Text style={{ fontSize: 14, color: '#E8EEF7', opacity: 0.88, textAlign: 'center' }}>中英双语</Text>
                </Box>
                <Box style={{ flex: 1, padding: '10px 6px', background: 'rgba(79,224,176,0.10)', borderRadius: 8, alignItems: 'center' }}>
                    <Text style={{ fontSize: 14, color: '#E8EEF7', opacity: 0.88, textAlign: 'center' }}>不用注册账号</Text>
                </Box>
            </Box>
        </Box>
    </Box>
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#E8EEF7', opacity: 0.42 }}>知歇 ZhiXie · V1.0.0</Text>
        <Text style={{ fontSize: 14, fontFamily: 'Consolas', color: '#E8EEF7', opacity: 0.42 }}>14 / 18</Text>
    </Box>
</Slide>
