        </Box>
        <Text style={{ fontSize: 22, fontFamily: 'Consolas', color: '#E8EEF7', opacity: 0.35 }}>29</Text>
    </Box>
    <Box style={{ height: 476, flexDirection: 'row', gap: 36 }}>
        <Box style={{ width: 720, flexDirection: 'column', gap: 14 }}>
            <Table
                style={{ width: 720, height: 380 }}
                defaultTextStyle={{ fontSize: 28, textAlign: 'left', color: '#E8EEF7' }}
                defaultCellStyle={{
                    border: {
                        left: { width: 1, color: 'rgba(232,238,247,0.12)' },
                        right: { width: 1, color: 'rgba(232,238,247,0.12)' },
