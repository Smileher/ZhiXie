                        bottom: { width: 1, color: 'rgba(232,238,247,0.12)' },
                    },
                }}
                cells={[
                    [
                        { text: '对比项', textStyle: { bold: true, color: '#0B1220' }, cellStyle: { background: { color: '#4FE0B0' } } },
                        { text: '常用工具', textStyle: { bold: true, color: '#0B1220' }, cellStyle: { background: { color: '#4FE0B0' } } },
                        { text: '知歇', textStyle: { bold: true, color: '#0B1220' }, cellStyle: { background: { color: '#4FE0B0' } } },
                    ],
                    [
                        { text: '建一条提醒', cellStyle: { background: { color: 'rgba(232,238,247,0.05)' } } },
                        '填一堆表单',
                        { text: '说一句话', textStyle: { bold: true, color: '#4FE0B0' } },
                    ],
                    [
                        '断网的时候',
                        '多半歇菜',
                        { text: '照样能用', textStyle: { bold: true, color: '#4FE0B0' } },
                    ],
                    [
                        { text: '到点锁屏 / 关机', cellStyle: { background: { color: 'rgba(232,238,247,0.05)' } } },
