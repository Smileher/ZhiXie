                    <circle cx='15' cy='15' r='13' fill='none' stroke='#4FE0B0' strokeWidth='1.5' />
                    <path d='M9 15 L13.5 20 L21 11' fill='none' stroke='#4FE0B0' strokeWidth='2.5' />
