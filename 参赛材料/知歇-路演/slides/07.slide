            <Box style={{ height: 140, flexDirection: 'column', justifyContent: 'center', alignItems: 'center', gap: 8, background: 'rgba(79,224,176,0.05)', border: '2px dashed rgba(79,224,176,0.55)', borderRadius: 12 }}>
