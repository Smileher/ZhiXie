            </Box>
            <Box style={{ flex: 1, height: 108, flexDirection: 'column', gap: 8, padding: '16px 20px', background: 'rgba(79,224,176,0.08)', border: '1px solid rgba(79,224,176,0.45)', borderRadius: 12 }}>
