<Slide style={{ width: 1280, height: 720, background: '#0B1220', padding: '20px 64px' }}>
    <Box style={{ height: 100, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between', paddingBottom: 18 }}>
        <Box style={{ flexDirection: 'column', gap: 6 }}>
            <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#E8EEF7' }}>说人话就行</Text>
            <Text style={{ fontSize: 16, color: '#E8EEF7', opacity: 0.55, letterSpacing: 1 }}>平时怎么说话，就怎么输</Text>
        </Box>
        <Text style={{ fontSize: 14, fontFamily: 'Consolas', color: '#E8EEF7', opacity: 0.35 }}>09</Text>
    </Box>
    <Box style={{ height: 500, flexDirection: 'row', gap: 32 }}>
        <Box style={{ width: 320, flexDirection: 'column', justifyContent: 'space-between', padding: 22, background: 'rgba(79,224,176,0.08)', border: '1px solid rgba(79,224,176,0.35)', borderRadius: 14 }}>
            <Box style={{ flexDirection: 'column', gap: 14 }}>
                <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#E8EEF7', lineHeight: 1.35 }}>不用套模板<br />不用背关键词</Text>
                <Box style={{ height: 3, width: 80, background: 'linear-gradient(135deg, #4FE0B0 0%, #2E9E8F 100%)', borderRadius: 2 }} />
                <Text style={{ fontSize: 15, color: '#E8EEF7', opacity: 0.72, lineHeight: 1.6 }}>时间、重复、要干什么说清楚就行，语序随便；「下午三点」「30分钟后」「每周一三五」这种连着写的说法也都认。</Text>
            </Box>
            <Box style={{ flexDirection: 'column', gap: 6, paddingTop: 14, borderTop: '1px solid rgba(232,238,247,0.14)' }}>
                <Text style={{ fontSize: 14, color: '#E8EEF7', opacity: 0.6, lineHeight: 1.5 }}>真没听懂的句子，会当成一条单次提醒，把你原话留作标题——不报错，也不丢。</Text>
            </Box>
        </Box>
        <Box style={{ flex: 1, flexDirection: 'column', gap: 8 }}>
            <Box style={{ height: 28, flexDirection: 'row', alignItems: 'center', paddingBottom: 6, borderBottom: '1px solid rgba(232,238,247,0.14)' }}>
                <Text style={{ width: 430, fontSize: 14, color: '#E8EEF7', opacity: 0.5, letterSpacing: 1 }}>你说的（日常口语）</Text>
                <Text style={{ flex: 1, fontSize: 14, color: '#E8EEF7', opacity: 0.5, letterSpacing: 1 }}>软件理解成</Text>
            </Box>
            <Box style={{ height: 54, flexDirection: 'row', alignItems: 'center', padding: '0 18px', background: 'rgba(232,238,247,0.04)', border: '1px solid rgba(232,238,247,0.10)', borderRadius: 10 }}>
                <Text style={{ width: 430, fontSize: 16, color: '#E8EEF7' }}>「每天下午三点提醒我喝水」</Text>
                <Text style={{ flex: 1, fontSize: 16, color: '#4FE0B0' }}>每天 · 15:00</Text>
            </Box>
            <Box style={{ height: 54, flexDirection: 'row', alignItems: 'center', padding: '0 18px', background: 'rgba(232,238,247,0.04)', border: '1px solid rgba(232,238,247,0.10)', borderRadius: 10 }}>
                <Text style={{ width: 430, fontSize: 16, color: '#E8EEF7' }}>「30分钟后提醒我起来接水」</Text>
                <Text style={{ flex: 1, fontSize: 16, color: '#4FE0B0' }}>一次 · 30 分钟后</Text>
            </Box>
            <Box style={{ height: 54, flexDirection: 'row', alignItems: 'center', padding: '0 18px', background: 'rgba(232,238,247,0.04)', border: '1px solid rgba(232,238,247,0.10)', borderRadius: 10 }}>
                <Text style={{ width: 430, fontSize: 16, color: '#E8EEF7' }}>「每周一三五 17:30 提醒我锁屏」</Text>
                <Text style={{ flex: 1, fontSize: 16, color: '#4FE0B0' }}>每周一 / 三 / 五 · 17:30 · 锁屏</Text>
            </Box>
            <Box style={{ height: 54, flexDirection: 'row', alignItems: 'center', padding: '0 18px', background: 'rgba(232,238,247,0.04)', border: '1px solid rgba(232,238,247,0.10)', borderRadius: 10 }}>
                <Text style={{ width: 430, fontSize: 16, color: '#E8EEF7' }}>「明天早上八点提醒我交作业」</Text>
                <Text style={{ flex: 1, fontSize: 16, color: '#4FE0B0' }}>一次 · 明天 08:00</Text>
            </Box>
            <Box style={{ height: 54, flexDirection: 'row', alignItems: 'center', padding: '0 18px', background: 'rgba(232,238,247,0.04)', border: '1px solid rgba(232,238,247,0.10)', borderRadius: 10 }}>
                <Text style={{ width: 430, fontSize: 16, color: '#E8EEF7' }}>「晚上十一点提醒我锁屏睡觉」</Text>
                <Text style={{ flex: 1, fontSize: 16, color: '#4FE0B0' }}>每天 · 23:00 · 锁屏</Text>
            </Box>
            <Box style={{ height: 110, flexDirection: 'column', justifyContent: 'center', alignItems: 'center', gap: 6, background: 'rgba(79,224,176,0.05)', border: '2px dashed rgba(79,224,176,0.55)', borderRadius: 10, marginTop: 4 }}>
                <Text style={{ fontSize: 13, fontFamily: 'Consolas', color: '#4FE0B0', letterSpacing: 1 }}>截图 ⑧</Text>
                <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#E8EEF7', textAlign: 'center' }}>智能体页 · 任意一条解析结果</Text>
                <Text style={{ fontSize: 12, color: '#E8EEF7', opacity: 0.5, textAlign: 'center', lineHeight: 1.5 }}>建议画面：任选一句口语，展示它被拆成四个字段</Text>
            </Box>
        </Box>
    </Box>
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#E8EEF7', opacity: 0.42 }}>知歇 ZhiXie · V1.0.0</Text>
        <Text style={{ fontSize: 14, fontFamily: 'Consolas', color: '#E8EEF7', opacity: 0.42 }}>09 / 18</Text>
    </Box>
</Slide>
