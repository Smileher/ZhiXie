                <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#0D9488' }}>结构化结果（JSON）</Text>
                <Text style={{ fontSize: 26, color: '#0B1220', opacity: 0.78, lineHeight: 1.5 }}>{ '{ type:"rest", time:"50m", repeat:"daily", action:"notify" }' }</Text>
