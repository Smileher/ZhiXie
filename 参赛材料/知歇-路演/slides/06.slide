    <Box style={{ height: 470, flexDirection: 'row', gap: 40, alignItems: 'center' }}>
      <Box style={{ width: 540, height: 440, background: '#1B2740', border: '1px solid rgba(232,238,247,0.12)', borderRadius: 14, padding: '24px 24px', flexDirection: 'column', gap: 14 }}>
        <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#E8EEF7' }}>高等教育在学规模 · 2024</Text>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10, height: 30 }}>
          <Text style={{ fontSize: 20, color: '#E8EEF7', opacity: 0.75, width: '140' }}>在学总规模</Text>
          <Box style={{ width: 230, height: 22, borderRadius: 6, background: 'rgba(232,238,247,0.08)' }}>
            <Box style={{ width: 230, height: 22, borderRadius: 6, background: 'linear-gradient(90deg, #4FE0B0, #2E9E8F)' }} />
          </Box>
          <Text style={{ fontSize: 19, fontFamily: 'Consolas', color: '#4FE0B0', fontWeight: 'bold' }}>4846万</Text>
        </Box>
