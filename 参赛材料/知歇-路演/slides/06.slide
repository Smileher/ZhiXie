    <Box style={{ height: 500, flexDirection: 'row', gap: 36 }}>
        <Box style={{ width: 660, height: 460, flexDirection: 'column', justifyContent: 'center', alignItems: 'center', gap: 12, background: 'rgba(79,224,176,0.05)', border: '2px dashed rgba(79,224,176,0.55)', borderRadius: 14 }}>
            <Text style={{ fontSize: 13, fontFamily: 'Consolas', color: '#4FE0B0', letterSpacing: 1 }}>截图 ④</Text>
            <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#E8EEF7', textAlign: 'center' }}>知歇主界面全貌</Text>
            <Text style={{ fontSize: 14, color: '#E8EEF7', opacity: 0.5, textAlign: 'center', lineHeight: 1.7 }}>建议画面：停在「休息节律」页，<br />顶栏五个胶囊导航完整可见<br />（休息节律 / 时间锚点 / 智能体 / 偏好调校 / 关于）</Text>
        </Box>
        <Box style={{ flex: 1, flexDirection: 'column', gap: 10 }}>
            <Box style={{ height: 80, flexDirection: 'column', justifyContent: 'center', gap: 4, padding: '0 18px', background: 'rgba(232,238,247,0.04)', border: '1px solid rgba(232,238,247,0.10)', borderRadius: 10 }}>
                <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#4FE0B0' }}>休息节律</Text>
                <Text style={{ fontSize: 15, color: '#E8EEF7', opacity: 0.7, lineHeight: 1.45 }}>开关休息提醒、设间隔、写自己想看的那句话</Text>
            </Box>
            <Box style={{ height: 80, flexDirection: 'column', justifyContent: 'center', gap: 4, padding: '0 18px', background: 'rgba(232,238,247,0.04)', border: '1px solid rgba(232,238,247,0.10)', borderRadius: 10 }}>
                <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#4FE0B0' }}>时间锚点</Text>
                <Text style={{ fontSize: 15, color: '#E8EEF7', opacity: 0.7, lineHeight: 1.45 }}>所有定时提醒都在这儿管：单次、每天、每周、每月</Text>
            </Box>
            <Box style={{ height: 80, flexDirection: 'column', justifyContent: 'center', gap: 4, padding: '0 18px', background: 'rgba(79,224,176,0.10)', border: '1px solid #4FE0B0', borderRadius: 10 }}>
                <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#4FE0B0' }}>智能体</Text>
                <Text style={{ fontSize: 15, color: '#E8EEF7', opacity: 0.78, lineHeight: 1.45 }}>说一句话，让它帮你把提醒生成出来</Text>
            </Box>
            <Box style={{ height: 80, flexDirection: 'column', justifyContent: 'center', gap: 4, padding: '0 18px', background: 'rgba(232,238,247,0.04)', border: '1px solid rgba(232,238,247,0.10)', borderRadius: 10 }}>
