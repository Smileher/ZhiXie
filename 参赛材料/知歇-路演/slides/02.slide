                <Box style={{ width: 60, height: 60, borderRadius: 30, background: 'rgba(79,224,176,0.10)', justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', fontFamily: 'Consolas', color: '#4FE0B0' }}>01</Text>
                </Box>
