      <Box style={{ width: 540, height: 440, background: '#1B2740', border: '1px solid rgba(232,238,247,0.12)', borderRadius: 14, padding: '24px 24px', flexDirection: 'column', gap: 12 }}>
        <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#E8EEF7' }}>青年久坐应对意愿 · 公开调研</Text>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10, height: 30 }}>
          <Text style={{ fontSize: 20, color: '#E8EEF7', opacity: 0.75, width: '190' }}>尝试过「轻养生」</Text>
          <Box style={{ width: 180, height: 22, borderRadius: 6, background: 'rgba(232,238,247,0.08)' }}>
