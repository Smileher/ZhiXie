<Slide style={{ width: 1280, height: 720, background: '#0B1220', padding: '20px 64px' }}>
    <Box style={{ height: 124, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between', paddingBottom: 16 }}>
        <Box style={{ flexDirection: 'column', gap: 4 }}>
            <Text style={{ fontSize: 46, fontWeight: 'bold', color: '#E8EEF7' }}>通道一：联网时交给大模型</Text>
            <Text style={{ fontSize: 28, color: '#E8EEF7', opacity: 0.6, letterSpacing: 1 }}>能听懂更自由的说法；但它只提建议</Text>
        </Box>
        <Text style={{ fontSize: 22, fontFamily: 'Consolas', color: '#E8EEF7', opacity: 0.35 }}>11</Text>
    </Box>
    <Box style={{ height: 476, flexDirection: 'row', gap: 40, alignItems: 'center' }}>
        <Box style={{ flex: 1, flexDirection: 'column', gap: 20 }}>
            <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#E8EEF7', lineHeight: 1.45 }}>联网时，这句话交给大模型去理解。</Text>
            <Box style={{ flexDirection: 'column', gap: 16 }}>
                <Text style={{ fontSize: 28, color: '#E8EEF7', opacity: 0.8, lineHeight: 1.5 }}>语序随便、说法自由，不用迁就关键词。</Text>
                <Text style={{ fontSize: 28, color: '#E8EEF7', opacity: 0.8, lineHeight: 1.5 }}>等太久或者连不上，会自动退回本机规则，不会卡住。</Text>
            </Box>
            <Box style={{ padding: '20px 22px', background: 'rgba(79,224,176,0.12)', border: '1px solid #4FE0B0', borderRadius: 12 }}>
                <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#4FE0B0', lineHeight: 1.45 }}>它给出的只是一份"草稿"</Text>
                <Text style={{ fontSize: 28, color: '#E8EEF7', lineHeight: 1.5, marginTop: 8 }}>能不能写进你的提醒列表，由软件说了算。</Text>
            </Box>
        </Box>
        <Box style={{ width: 480, height: 400, flexDirection: 'column', justifyContent: 'center', alignItems: 'center', gap: 12, background: 'rgba(79,224,176,0.05)', border: '2px dashed rgba(79,224,176,0.55)', borderRadius: 14, padding: '0 20px' }}>
            <Text style={{ fontSize: 22, fontFamily: 'Consolas', color: '#4FE0B0', letterSpacing: 1 }}>截图 ⑯</Text>
            <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#E8EEF7', textAlign: 'center' }}>云端模式下的解析结果</Text>
            <Text style={{ fontSize: 22, color: '#E8EEF7', opacity: 0.5, textAlign: 'center', lineHeight: 1.7 }}>建议画面：顶部模式胶囊显示「云端大模型」，<br />结果旁标注来源</Text>
        </Box>
    </Box>
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 22, color: '#E8EEF7', opacity: 0.45 }}>知歇 ZhiXie · V1.0.0</Text>
        <Text style={{ fontSize: 22, fontFamily: 'Consolas', color: '#E8EEF7', opacity: 0.45 }}>11 / 30</Text>
    </Box>
</Slide>
