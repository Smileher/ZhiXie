<Slide style={{ width: 1280, height: 720, background: '#F5F9FC', padding: '20px 64px' }}>
    <Box style={{ height: 124, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between', paddingBottom: 16 }}>
        <Box style={{ flexDirection: 'column', gap: 4 }}>
            <Text style={{ fontSize: 46, fontWeight: 'bold', color: '#0B1220' }}>工作流程：五步走</Text>
            <Text style={{ fontSize: 28, color: '#0B1220', opacity: 0.6, letterSpacing: 1 }}>从你开口到提醒生效，中间只有五步</Text>
        </Box>
        <Text style={{ fontSize: 22, fontFamily: 'Consolas', color: '#0B1220', opacity: 0.35 }}>11</Text>
    </Box>
    <Box style={{ height: 476, flexDirection: 'column', gap: 8 }}>
        <Box style={{ height: 88, flexDirection: 'row', alignItems: 'center', gap: 24, padding: '0 24px', background: '#FFFFFF', border: '1px solid rgba(11,18,32,0.10)', borderRadius: 12 }}>
            <Text style={{ fontSize: 52, fontWeight: 'bold', fontFamily: 'Consolas', color: '#0D9488', lineHeight: 1 }}>01</Text>
            <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0B1220', width: 260 }}>你说一句话</Text>
            <Text style={{ fontSize: 28, color: '#0B1220', opacity: 0.75, flex: 1 }}>时间、重复、要干什么说清楚就行，语序随便。</Text>
        </Box>
        <Box style={{ height: 88, flexDirection: 'row', alignItems: 'center', gap: 24, padding: '0 24px', background: '#FFFFFF', border: '1px solid rgba(11,18,32,0.10)', borderRadius: 12 }}>
            <Text style={{ fontSize: 52, fontWeight: 'bold', fontFamily: 'Consolas', color: '#0D9488', lineHeight: 1 }}>02</Text>
            <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0B1220', width: 260 }}>智能体去理解</Text>
            <Text style={{ fontSize: 28, color: '#0B1220', opacity: 0.75, flex: 1 }}>联网交给大模型，没网用自带规则，你不用管走的哪条。</Text>
        </Box>
        <Box style={{ height: 88, flexDirection: 'row', alignItems: 'center', gap: 24, padding: '0 24px', background: '#FFFFFF', border: '1px solid rgba(11,18,32,0.10)', borderRadius: 12 }}>
            <Text style={{ fontSize: 52, fontWeight: 'bold', fontFamily: 'Consolas', color: '#0D9488', lineHeight: 1 }}>03</Text>
            <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0B1220', width: 260 }}>系统先核一遍</Text>
            <Text style={{ fontSize: 28, color: '#0B1220', opacity: 0.75, flex: 1 }}>不合规的字段被退回或丢掉，不会混进你的提醒列表。</Text>
        </Box>
        <Box style={{ height: 88, flexDirection: 'row', alignItems: 'center', gap: 24, padding: '0 24px', background: '#FFFFFF', border: '1px solid rgba(11,18,32,0.10)', borderRadius: 12 }}>
            <Text style={{ fontSize: 52, fontWeight: 'bold', fontFamily: 'Consolas', color: '#0D9488', lineHeight: 1 }}>04</Text>
            <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0B1220', width: 260 }}>你点确认</Text>
            <Text style={{ fontSize: 28, color: '#0B1220', opacity: 0.75, flex: 1 }}>结果摆成一张表单，对不对一眼看得出，你点头才算数。</Text>
        </Box>
        <Box style={{ height: 88, flexDirection: 'row', alignItems: 'center', gap: 24, padding: '0 24px', background: 'rgba(79,224,176,0.16)', border: '1px solid rgba(13,148,136,0.35)', borderRadius: 12 }}>
            <Text style={{ fontSize: 52, fontWeight: 'bold', fontFamily: 'Consolas', color: '#0D9488', lineHeight: 1 }}>05</Text>
            <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0B1220', width: 260 }}>写进提醒列表</Text>
            <Text style={{ fontSize: 28, color: '#0B1220', opacity: 0.85, flex: 1 }}>到点弹出，可以推迟，也可以顺带锁屏、关机。</Text>
        </Box>
    </Box>
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 22, color: '#0B1220', opacity: 0.4 }}>知歇 ZhiXie · V1.0.0</Text>
        <Text style={{ fontSize: 22, fontFamily: 'Consolas', color: '#0B1220', opacity: 0.4 }}>11 / 38</Text>
    </Box>
</Slide>
