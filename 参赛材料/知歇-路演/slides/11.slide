<Slide style={{ width: 1280, height: 720, background: '#0B1220', padding: '20px 64px' }}>
    <Box style={{ height: 100, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between', paddingBottom: 18 }}>
        <Box style={{ flexDirection: 'column', gap: 6 }}>
            <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#E8EEF7' }}>平时怎么用</Text>
            <Text style={{ fontSize: 16, color: '#E8EEF7', opacity: 0.55, letterSpacing: 1 }}>除了定时提醒，还有两种最常用的用法</Text>
        </Box>
        <Text style={{ fontSize: 14, fontFamily: 'Consolas', color: '#E8EEF7', opacity: 0.35 }}>11</Text>
    </Box>
    <Box style={{ height: 500, flexDirection: 'column', gap: 16 }}>
        <Box style={{ flexDirection: 'row', gap: 28 }}>
            <Box style={{ flex: 1, height: 320, flexDirection: 'column', justifyContent: 'center', alignItems: 'center', gap: 10, background: 'rgba(79,224,176,0.05)', border: '2px dashed rgba(79,224,176,0.55)', borderRadius: 12 }}>
                <Text style={{ fontSize: 13, fontFamily: 'Consolas', color: '#4FE0B0', letterSpacing: 1 }}>截图 ⑪</Text>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#E8EEF7', textAlign: 'center' }}>休息节律页</Text>
                <Text style={{ fontSize: 13, color: '#E8EEF7', opacity: 0.5, textAlign: 'center', lineHeight: 1.6 }}>建议画面：间隔设置<br />+ 本轮进度条</Text>
            </Box>
            <Box style={{ flex: 1, height: 320, flexDirection: 'column', justifyContent: 'center', alignItems: 'center', gap: 10, background: 'rgba(79,224,176,0.05)', border: '2px dashed rgba(79,224,176,0.55)', borderRadius: 12 }}>
                <Text style={{ fontSize: 13, fontFamily: 'Consolas', color: '#4FE0B0', letterSpacing: 1 }}>截图 ⑫</Text>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#E8EEF7', textAlign: 'center' }}>智能体页 · 休息建议卡片</Text>
                <Text style={{ fontSize: 13, color: '#E8EEF7', opacity: 0.5, textAlign: 'center', lineHeight: 1.6 }}>建议画面：点「换个建议」后<br />出现的那一条建议</Text>
            </Box>
        </Box>
        <Box style={{ flexDirection: 'row', gap: 20 }}>
            <Box style={{ flex: 1, height: 132, flexDirection: 'column', gap: 8, padding: 18, background: 'rgba(232,238,247,0.04)', border: '1px solid rgba(232,238,247,0.10)', borderRadius: 12 }}>
                <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#4FE0B0' }}>休息节律：到点就提醒，不用一条条设</Text>
                <Text style={{ fontSize: 15, color: '#E8EEF7', opacity: 0.72, lineHeight: 1.55 }}>默认每 40 分钟一次，间隔和提示语随时改；界面上有进度条，本轮还剩多久一眼看得到。</Text>
            </Box>
            <Box style={{ flex: 1, height: 132, flexDirection: 'column', gap: 8, padding: 18, background: 'rgba(232,238,247,0.04)', border: '1px solid rgba(232,238,247,0.10)', borderRadius: 12 }}>
                <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#4FE0B0' }}>休息建议：不知道该干嘛，它给一句</Text>
                <Text style={{ fontSize: 15, color: '#E8EEF7', opacity: 0.72, lineHeight: 1.55 }}>点一下「换个建议」，它会看你设的间隔和已经提醒过几次，给一句能马上做的事：站起来走几步、喝口水。</Text>
            </Box>
        </Box>
    </Box>
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#E8EEF7', opacity: 0.42 }}>知歇 ZhiXie · V1.0.0</Text>
        <Text style={{ fontSize: 14, fontFamily: 'Consolas', color: '#E8EEF7', opacity: 0.42 }}>11 / 18</Text>
    </Box>
</Slide>
