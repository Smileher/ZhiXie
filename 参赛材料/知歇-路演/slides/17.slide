<Slide style={{ width: 1280, height: 720, background: '#0B1220', padding: '20px 64px' }}>
    <Box style={{ height: 100, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between', paddingBottom: 18 }}>
        <Box style={{ flexDirection: 'column', gap: 6 }}>
            <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#E8EEF7' }}>五个不一样的地方</Text>
            <Text style={{ fontSize: 16, color: '#E8EEF7', opacity: 0.55, letterSpacing: 1 }}>每条都对应一个看得见的动作，不是说法</Text>
        </Box>
        <Text style={{ fontSize: 14, fontFamily: 'Consolas', color: '#4FE0B0', opacity: 0.8 }}>创新点</Text>
    </Box>
    <Box style={{ height: 500, flexDirection: 'row', gap: 32 }}>
        <Box style={{ flex: 1, flexDirection: 'column', gap: 10 }}>
            <Box style={{ height: 80, flexDirection: 'row', alignItems: 'center', gap: 18, padding: '0 20px', background: 'rgba(232,238,247,0.04)', border: '1px solid rgba(232,238,247,0.10)', borderRadius: 10 }}>
                <Text style={{ fontSize: 38, fontWeight: 'bold', fontFamily: 'Consolas', color: '#4FE0B0', lineHeight: 1 }}>01</Text>
                <Box style={{ flexDirection: 'column', gap: 4 }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#E8EEF7' }}>说一句话就把提醒设好</Text>
                    <Text style={{ fontSize: 14, color: '#E8EEF7', opacity: 0.65 }}>不用点一堆表单，也不用先学一套说法。</Text>
                </Box>
            </Box>
            <Box style={{ height: 80, flexDirection: 'row', alignItems: 'center', gap: 18, padding: '0 20px', background: 'rgba(232,238,247,0.04)', border: '1px solid rgba(232,238,247,0.10)', borderRadius: 10 }}>
                <Text style={{ fontSize: 38, fontWeight: 'bold', fontFamily: 'Consolas', color: '#4FE0B0', lineHeight: 1 }}>02</Text>
                <Box style={{ flexDirection: 'column', gap: 4 }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#E8EEF7' }}>没网也能听懂你</Text>
                    <Text style={{ fontSize: 14, color: '#E8EEF7', opacity: 0.65 }}>软件自带一套规则，断网照样解析，功能不断。</Text>
                </Box>
            </Box>
            <Box style={{ height: 80, flexDirection: 'row', alignItems: 'center', gap: 18, padding: '0 20px', background: 'rgba(232,238,247,0.04)', border: '1px solid rgba(232,238,247,0.10)', borderRadius: 10 }}>
                <Text style={{ fontSize: 38, fontWeight: 'bold', fontFamily: 'Consolas', color: '#4FE0B0', lineHeight: 1 }}>03</Text>
                <Box style={{ flexDirection: 'column', gap: 4 }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#E8EEF7' }}>AI 说的会先核一遍</Text>
                    <Text style={{ fontSize: 14, color: '#E8EEF7', opacity: 0.65 }}>不合规的内容写不进你的提醒列表。</Text>
                </Box>
            </Box>
            <Box style={{ height: 80, flexDirection: 'row', alignItems: 'center', gap: 18, padding: '0 20px', background: 'rgba(232,238,247,0.04)', border: '1px solid rgba(232,238,247,0.10)', borderRadius: 10 }}>
                <Text style={{ fontSize: 38, fontWeight: 'bold', fontFamily: 'Consolas', color: '#4FE0B0', lineHeight: 1 }}>04</Text>
                <Box style={{ flexDirection: 'column', gap: 4 }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#E8EEF7' }}>一个人 + AI 助手做出来的</Text>
                    <Text style={{ fontSize: 14, color: '#E8EEF7', opacity: 0.65 }}>想法、结构、检查都是自己定的，AI 帮忙写代码，138 项检查兜底。</Text>
                </Box>
            </Box>
            <Box style={{ height: 80, flexDirection: 'row', alignItems: 'center', gap: 18, padding: '0 20px', background: 'rgba(232,238,247,0.04)', border: '1px solid rgba(232,238,247,0.10)', borderRadius: 10 }}>
                <Text style={{ fontSize: 38, fontWeight: 'bold', fontFamily: 'Consolas', color: '#4FE0B0', lineHeight: 1 }}>05</Text>
                <Box style={{ flexDirection: 'column', gap: 4 }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#E8EEF7' }}>立场是让你休息</Text>
                    <Text style={{ fontSize: 14, color: '#E8EEF7', opacity: 0.65 }}>不催你干活，不比谁更拼，文案也不制造焦虑。</Text>
                </Box>
            </Box>
        </Box>
        <Box style={{ width: 450, flexDirection: 'column', gap: 14 }}>
            <Box style={{ flexDirection: 'column', gap: 10, padding: 20, background: 'rgba(232,238,247,0.05)', border: '1px solid rgba(232,238,247,0.12)', borderRadius: 12 }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#4FE0B0' }}>和现在常用的工具比</Text>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
                    <Text style={{ width: 150, fontSize: 14, color: '#E8EEF7', opacity: 0.5 }}>对比项</Text>
                    <Text style={{ flex: 1, fontSize: 14, color: '#E8EEF7', opacity: 0.5 }}>常用工具</Text>
                    <Text style={{ flex: 1, fontSize: 14, color: '#4FE0B0' }}>知歇</Text>
                </Box>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
                    <Text style={{ width: 150, fontSize: 15, color: '#E8EEF7' }}>建一条提醒</Text>
                    <Text style={{ flex: 1, fontSize: 14, color: '#E8EEF7', opacity: 0.55 }}>填一堆表单</Text>
                    <Text style={{ flex: 1, fontSize: 15, fontWeight: 'bold', color: '#4FE0B0' }}>说一句话</Text>
                </Box>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
                    <Text style={{ width: 150, fontSize: 15, color: '#E8EEF7' }}>断网的时候</Text>
                    <Text style={{ flex: 1, fontSize: 14, color: '#E8EEF7', opacity: 0.55 }}>多半歇菜</Text>
                    <Text style={{ flex: 1, fontSize: 15, fontWeight: 'bold', color: '#4FE0B0' }}>照样能用</Text>
                </Box>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
                    <Text style={{ width: 150, fontSize: 15, color: '#E8EEF7' }}>到点锁屏 / 关机</Text>
                    <Text style={{ flex: 1, fontSize: 14, color: '#E8EEF7', opacity: 0.55 }}>基本没有</Text>
                    <Text style={{ flex: 1, fontSize: 15, fontWeight: 'bold', color: '#4FE0B0' }}>有，留 60 秒反悔</Text>
                </Box>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
                    <Text style={{ width: 150, fontSize: 15, color: '#E8EEF7' }}>要不要账号</Text>
                    <Text style={{ flex: 1, fontSize: 14, color: '#E8EEF7', opacity: 0.55 }}>不少要登录</Text>
                    <Text style={{ flex: 1, fontSize: 15, fontWeight: 'bold', color: '#4FE0B0' }}>不要，数据在本机</Text>
                </Box>
            </Box>
            <Box style={{ flexDirection: 'column', justifyContent: 'center', padding: '16px 20px', background: 'rgba(79,224,176,0.12)', border: '1px solid #4FE0B0', borderRadius: 12 }}>
                <Text style={{ fontSize: 16, color: '#E8EEF7', lineHeight: 1.6 }}>说到底就一句：把一件"知道该做、却懒得去设"的事，变成说一句话的事。</Text>
            </Box>
        </Box>
    </Box>
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#E8EEF7', opacity: 0.42 }}>知歇 ZhiXie · V1.0.0</Text>
        <Text style={{ fontSize: 14, fontFamily: 'Consolas', color: '#E8EEF7', opacity: 0.42 }}>17 / 18</Text>
    </Box>
</Slide>
