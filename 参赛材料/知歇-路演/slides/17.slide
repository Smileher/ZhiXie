<Slide style={{ width: 1280, height: 720, background: '#0B1220', padding: '20px 64px' }}>
    <Box style={{ height: 124, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between', paddingBottom: 16 }}>
        <Box style={{ flexDirection: 'column', gap: 4 }}>
            <Text style={{ fontSize: 46, fontWeight: 'bold', color: '#E8EEF7' }}>模型选型：选谁、怎么换</Text>
            <Text style={{ fontSize: 28, color: '#E8EEF7', opacity: 0.6, letterSpacing: 1 }}>不绑定一家，改两格就能换</Text>
        </Box>
        <Text style={{ fontSize: 22, fontFamily: 'Consolas', color: '#4FE0B0', opacity: 0.8 }}>AI 开发</Text>
    </Box>
    <Box style={{ height: 476, flexDirection: 'row', gap: 40, alignItems: 'center' }}>
        <Box style={{ flex: 1, flexDirection: 'column', gap: 20 }}>
            <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#E8EEF7', lineHeight: 1.45 }}>默认给的是一个开箱可用的选择。</Text>
            <Box style={{ flexDirection: 'column', gap: 16 }}>
                <Text style={{ fontSize: 28, color: '#E8EEF7', opacity: 0.8, lineHeight: 1.5 }}>挑它的理由：中文说法处理得好、便宜、不用排队。</Text>
                <Text style={{ fontSize: 28, color: '#E8EEF7', opacity: 0.8, lineHeight: 1.5 }}>接口用的是通用格式，不是独家协议。</Text>
            </Box>
            <Box style={{ padding: '20px 22px', background: 'rgba(79,224,176,0.12)', border: '1px solid #4FE0B0', borderRadius: 12 }}>
                <Text style={{ fontSize: 28, color: '#E8EEF7', lineHeight: 1.5 }}>想换就改<span style={{ color: '#4FE0B0', fontWeight: 'bold' }}>地址和模型名两格</span>，不用动代码；不填也完全能用。</Text>
            </Box>
        </Box>
        <Box style={{ width: 480, flexDirection: 'column', gap: 14 }}>
            <Box style={{ height: 116, flexDirection: 'column', gap: 8, padding: '16px 18px', background: 'rgba(79,224,176,0.06)', border: '1px solid rgba(79,224,176,0.35)', borderRadius: 12 }}>
                <Text style={{ fontSize: 24, color: '#E8EEF7', opacity: 0.6 }}>接口地址</Text>
                <Text style={{ fontSize: 26, fontFamily: 'Consolas', color: '#4FE0B0' }}>https://api.…/chat/completions</Text>
            </Box>
            <Box style={{ height: 116, flexDirection: 'column', gap: 8, padding: '16px 18px', background: 'rgba(79,224,176,0.06)', border: '1px solid rgba(79,224,176,0.35)', borderRadius: 12 }}>
                <Text style={{ fontSize: 24, color: '#E8EEF7', opacity: 0.6 }}>模型名称</Text>
                <Text style={{ fontSize: 26, fontFamily: 'Consolas', color: '#4FE0B0' }}>模型名（可改）</Text>
            </Box>
            <Box style={{ height: 116, flexDirection: 'column', gap: 8, padding: '16px 18px', background: 'rgba(79,224,176,0.06)', border: '1px solid rgba(79,224,176,0.35)', borderRadius: 12 }}>
                <Text style={{ fontSize: 24, color: '#E8EEF7', opacity: 0.6 }}>密钥</Text>
                <Text style={{ fontSize: 26, fontFamily: 'Consolas', color: '#4FE0B0' }}>••••••••••••（只存本机）</Text>
            </Box>
            <Text style={{ fontSize: 22, color: '#E8EEF7', opacity: 0.5, lineHeight: 1.5 }}>三格填完即可，全程不用写一行代码。</Text>
        </Box>
    </Box>
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 22, color: '#E8EEF7', opacity: 0.45 }}>知歇 ZhiXie · V1.0.0</Text>
        <Text style={{ fontSize: 22, fontFamily: 'Consolas', color: '#E8EEF7', opacity: 0.45 }}>17 / 30</Text>
    </Box>
</Slide>
