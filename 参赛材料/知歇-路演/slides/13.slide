<Slide style={{ width: 1280, height: 720, background: '#0B1220', padding: '20px 64px' }}>
    <Box style={{ height: 124, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between', paddingBottom: 16 }}>
        <Box style={{ flexDirection: 'column', gap: 4 }}>
            <Text style={{ fontSize: 46, fontWeight: 'bold', color: '#E8EEF7' }}>校验层：AI 说的先核一遍</Text>
            <Text style={{ fontSize: 28, color: '#E8EEF7', opacity: 0.6, letterSpacing: 1 }}>只认列举出来的这些，不合规就不写进去</Text>
        </Box>
        <Text style={{ fontSize: 22, fontFamily: 'Consolas', color: '#4FE0B0', opacity: 0.8 }}>可靠性</Text>
    </Box>
    <Box style={{ height: 476, flexDirection: 'row', gap: 32 }}>
        <Box style={{ width: 700, flexDirection: 'column', gap: 12 }}>
            <Table
                style={{ width: 700, height: 344 }}
                defaultTextStyle={{ fontSize: 27, textAlign: 'left', color: '#E8EEF7' }}
                defaultCellStyle={{
                    border: {
                        left: { width: 1, color: 'rgba(232,238,247,0.12)' },
                        right: { width: 1, color: 'rgba(232,238,247,0.12)' },
                        top: { width: 1, color: 'rgba(232,238,247,0.12)' },
                        bottom: { width: 1, color: 'rgba(232,238,247,0.12)' },
                    },
                }}
                cells={[
                    [
                        { text: '检查什么', textStyle: { bold: true, color: '#0B1220' }, cellStyle: { background: { color: '#4FE0B0' } } },
                        { text: '只认这些', textStyle: { bold: true, color: '#0B1220' }, cellStyle: { background: { color: '#4FE0B0' } } },
                        { text: '不合规怎么办', textStyle: { bold: true, color: '#0B1220' }, cellStyle: { background: { color: '#4FE0B0' } } },
                    ],
                    [
                        { text: '类型', cellStyle: { background: { color: 'rgba(232,238,247,0.05)' } } },
                        '单次 / 每天 / 每周 / 每月',
                        { text: '退回「单次」', textStyle: { color: '#4FE0B0' } },
                    ],
                    [
                        '时间',
                        '合法的 时:分',
                        { text: '退回早上 9:00', textStyle: { color: '#4FE0B0' } },
                    ],
                    [
                        { text: '星期', cellStyle: { background: { color: 'rgba(232,238,247,0.05)' } } },
                        '只能是 0–6',
                        { text: '越界的直接丢掉', textStyle: { color: '#4FE0B0' } },
                    ],
                    [
                        '日期',
                        '只能是 1–31',
                        { text: '越界的直接丢掉', textStyle: { color: '#4FE0B0' } },
                    ],
                    [
                        { text: '系统操作', cellStyle: { background: { color: 'rgba(232,238,247,0.05)' } } },
                        '锁屏 / 关机 / 重启',
                        { text: '置空，不执行', textStyle: { color: '#4FE0B0' } },
                    ],
                ]}
            />
            <Text style={{ fontSize: 22, color: '#E8EEF7', opacity: 0.6, lineHeight: 1.5 }}>标题也不能为空，为空就用你原来那句话。</Text>
        </Box>
        <Box style={{ flex: 1, flexDirection: 'column', gap: 16 }}>
            <Box style={{ height: 186, flexDirection: 'column', justifyContent: 'center', alignItems: 'center', gap: 8, background: 'rgba(79,224,176,0.05)', border: '2px dashed rgba(79,224,176,0.55)', borderRadius: 12, padding: '0 16px' }}>
                <Text style={{ fontSize: 22, fontFamily: 'Consolas', color: '#4FE0B0', letterSpacing: 1 }}>截图 ⑮</Text>
                <Text style={{ fontSize: 28, fontWeight: 'bold', color: '#E8EEF7', textAlign: 'center' }}>解析结果页（标注来源）</Text>
                <Text style={{ fontSize: 22, color: '#E8EEF7', opacity: 0.5, textAlign: 'center', lineHeight: 1.6 }}>建议画面：结果旁「来自云端大模型 /<br />来自本机引擎」的标注</Text>
            </Box>
            <Box style={{ flex: 1, flexDirection: 'column', justifyContent: 'center', gap: 12, padding: '20px 22px', background: 'rgba(79,224,176,0.12)', border: '1px solid #4FE0B0', borderRadius: 12 }}>
                <Text style={{ fontSize: 28, color: '#E8EEF7', lineHeight: 1.55 }}>大模型负责<span style={{ fontWeight: 'bold', color: '#4FE0B0' }}>提建议</span>，软件负责<span style={{ fontWeight: 'bold', color: '#4FE0B0' }}>判断能不能用</span>。</Text>
                <Text style={{ fontSize: 28, color: '#E8EEF7', lineHeight: 1.55 }}>结果先摆成表单，<span style={{ fontWeight: 'bold', color: '#4FE0B0' }}>你点确认才写入</span>。</Text>
            </Box>
        </Box>
    </Box>
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 22, color: '#E8EEF7', opacity: 0.45 }}>知歇 ZhiXie · V1.0.0</Text>
        <Text style={{ fontSize: 22, fontFamily: 'Consolas', color: '#E8EEF7', opacity: 0.45 }}>13 / 30</Text>
    </Box>
</Slide>
