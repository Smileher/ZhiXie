    <Box style={{ height: 470, flexDirection: 'row', gap: 40, alignItems: 'center' }}>
      <Box style={{ flex: 1, flexDirection: 'column', gap: 18 }}>
        <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#4FE0B0', lineHeight: 1.4 }}>您上一次连续坐在电脑前，<br />是多久？</Text>
        <Text style={{ fontSize: 28, color: '#E8EEF7', opacity: 0.8, lineHeight: 1.5 }}>一进入专注，时间感就没了。</Text>
        <Text style={{ fontSize: 28, color: '#E8EEF7', opacity: 0.8, lineHeight: 1.5 }}>身体一直在发信号，只是被忽略。</Text>
        <Box style={{ background: 'rgba(79,224,176,0.10)', border: '1px solid rgba(79,224,176,0.4)', borderRadius: 12, padding: '18px 22px'}}>
          <Text style={{ fontSize: 28, color: '#E8EEF7', lineHeight: 1.5 }}>谁能用上：<span style={{ color: '#4FE0B0', fontWeight: 'bold' }}>学生、久坐办公的人</span></Text>
