                <rect x='182' y='10' width='150' height='54' rx='8' fill='rgba(232,238,247,0.06)' stroke='rgba(232,238,247,0.16)' />
                <rect x='182' y='80' width='150' height='54' rx='8' fill='rgba(232,238,247,0.06)' stroke='rgba(232,238,247,0.16)' />
                <rect x='182' y='150' width='150' height='54' rx='8' fill='rgba(232,238,247,0.06)' stroke='rgba(232,238,247,0.16)' />
                <path d='M364 107 L424 107' fill='none' stroke='#4FE0B0' strokeWidth='2' opacity='0.8' />
                <path d='M424 107 L438 100 L438 114 Z' fill='#4FE0B0' />
                <rect x='452' y='80' width='196' height='54' rx='8' fill='rgba(79,224,176,0.12)' stroke='#4FE0B0' />
                <circle cx='478' cy='107' r='6' fill='#4FE0B0' />
                <rect x='0' y='10' width='0' height='0' fill='none' />
            </svg>
            <Box style={{ marginTop: 'auto', padding: '14px 18px', background: 'rgba(79,224,176,0.10)', borderRadius: 10 }}>
                <Text style={{ fontSize: 16, color: '#E8EEF7', opacity: 0.85, lineHeight: 1.5 }}>门槛不在按钮多少，而在"单次 / 每天 / 每周 / 每月"这套概念本身——用户要先成为半个日程软件专家。</Text>
            </Box>
        </Box>
        <Box style={{ flex: 1, flexDirection: 'column', gap: 16, padding: 26, background: 'rgba(232,238,247,0.04)', border: '1px solid rgba(232,238,247,0.10)', borderRadius: 14 }}>
            <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#E8EEF7' }}>毛病二 · 提醒机械</Text>
            <Text style={{ fontSize: 17, color: '#E8EEF7', opacity: 0.62, lineHeight: 1.5 }}>固定文案反复弹出，几轮之后被大脑自动过滤。</Text>
            <svg width={376} height={214} viewBox='0 0 376 214'>
                <rect x='0' y='14' width='376' height='40' rx='8' fill='rgba(232,238,247,0.08)' stroke='rgba(232,238,247,0.18)' />
                <rect x='0' y='66' width='376' height='40' rx='8' fill='rgba(232,238,247,0.06)' stroke='rgba(232,238,247,0.14)' opacity='0.85' />
                <rect x='0' y='118' width='376' height='40' rx='8' fill='rgba(232,238,247,0.04)' stroke='rgba(232,238,247,0.10)' opacity='0.6' />
                <rect x='0' y='170' width='376' height='40' rx='8' fill='rgba(232,238,247,0.02)' stroke='rgba(232,238,247,0.07)' opacity='0.4' />
