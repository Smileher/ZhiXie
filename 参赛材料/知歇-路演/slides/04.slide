                <path d='M300 86 L320 86' fill='none' stroke='#4FE0B0' strokeWidth='2' opacity='0.35' />
                <path d='M300 138 L308 138' fill='none' stroke='#4FE0B0' strokeWidth='2' opacity='0.18' />
            </svg>
            <Box style={{ marginTop: 'auto', padding: '14px 18px', background: 'rgba(79,224,176,0.10)', borderRadius: 10 }}>
                <Text style={{ fontSize: 16, color: '#E8EEF7', opacity: 0.85, lineHeight: 1.5 }}>提醒的强度随重复次数递减——第三次之后，它和桌面壁纸没有区别。</Text>
            </Box>
        </Box>
    </Box>
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
