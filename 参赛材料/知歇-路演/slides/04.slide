<Slide style={{ width: 1280, height: 720, background: '#0B1220', padding: '20px 64px' }}>
    <Box style={{ height: 100, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between', paddingBottom: 18 }}>
        <Box style={{ flexDirection: 'column', gap: 6 }}>
            <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#E8EEF7' }}>两个绕不开的毛病</Text>
            <Text style={{ fontSize: 16, color: '#E8EEF7', opacity: 0.55, letterSpacing: 1 }}>不是用户不想休息，是工具不好用</Text>
        </Box>
        <Text style={{ fontSize: 14, fontFamily: 'Consolas', color: '#E8EEF7', opacity: 0.35 }}>04</Text>
    </Box>
    <Box style={{ height: 500, flexDirection: 'row', gap: 32 }}>
        <Box style={{ width: 700, flexDirection: 'column', gap: 16, padding: 26, background: 'rgba(232,238,247,0.04)', border: '1px solid rgba(232,238,247,0.10)', borderRadius: 14 }}>
            <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#E8EEF7' }}>毛病一 · 配置门槛高</Text>
            <Text style={{ fontSize: 17, color: '#E8EEF7', opacity: 0.62, lineHeight: 1.5 }}>想设一条「每周一三五下午三点半」，得先学会四套概念。</Text>
            <svg width={648} height={214} viewBox='0 0 648 214'>
                <rect x='0' y='10' width='150' height='54' rx='8' fill='rgba(232,238,247,0.06)' stroke='rgba(232,238,247,0.16)' />
                <rect x='0' y='80' width='150' height='54' rx='8' fill='rgba(232,238,247,0.06)' stroke='rgba(232,238,247,0.16)' />
