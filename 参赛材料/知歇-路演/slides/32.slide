<Slide style={{ width: 1280, height: 720, background: '#F5F9FC', padding: '20px 64px' }}>
    <Box style={{ height: 124, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between', paddingBottom: 16 }}>
        <Box style={{ flexDirection: 'column', gap: 4 }}>
            <Text style={{ fontSize: 46, fontWeight: 'bold', color: '#0B1220' }}>创新详解① · 说一句话建提醒</Text>
            <Text style={{ fontSize: 28, color: '#0B1220', opacity: 0.6, letterSpacing: 1 }}>自然语言替代一堆表单，零学习成本</Text>
        </Box>
        <Text style={{ fontSize: 22, fontFamily: 'Consolas', color: '#0B1220', opacity: 0.35 }}>32</Text>
    </Box>
    <Box style={{ height: 476, flexDirection: 'row', gap: 40, alignItems: 'center' }}>
        <Box style={{ flex: 1, flexDirection: 'column', gap: 18, justifyContent: 'center' }}>
            <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#0D9488', lineHeight: 1.4 }}>不用学怎么填表单。</Text>
            <Text style={{ fontSize: 28, color: '#0B1220', opacity: 0.8, lineHeight: 1.5 }}>想怎么说就怎么说，顺序也不重要。</Text>
            <Text style={{ fontSize: 28, color: '#0B1220', opacity: 0.8, lineHeight: 1.5 }}>第一次用就能建好一条提醒。</Text>
            <Box style={{ padding: '18px 22px', background: 'rgba(79,224,176,0.16)', border: '1px solid rgba(13,148,136,0.35)', borderRadius: 12 }}>
                <Text style={{ fontSize: 28, color: '#0B1220', lineHeight: 1.5 }}>门槛 = <span style={{ color: '#0D9488', fontWeight: 'bold' }}>会说中文</span></Text>
            </Box>
        </Box>
        <Box style={{ width: 560, height: 420, flexDirection: 'column', gap: 16, padding: '26px 28px', background: '#FFFFFF', border: '1px solid rgba(11,18,32,0.10)', borderRadius: 12, justifyContent: 'center' }}>
            <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#0D9488' }}>对照</Text>
            <Box style={{ flexDirection: 'row', gap: 16 }}>
                <Box style={{ flex: 1, flexDirection: 'column', gap: 10, padding: '18px', background: 'rgba(79,224,176,0.14)', borderRadius: 10 }}>
                    <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#0D9488' }}>你做的</Text>
                    <Text style={{ fontSize: 28, color: '#0B1220', opacity: 0.85, lineHeight: 1.5 }}>"每久坐 50 分钟提醒我"</Text>
                </Box>
                <Box style={{ flex: 1, flexDirection: 'column', gap: 10, padding: '18px', background: '#F5F9FC', border: '1px solid rgba(11,18,32,0.10)', borderRadius: 10 }}>
                    <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#0B1220', opacity: 0.6 }}>传统做法</Text>
                    <Text style={{ fontSize: 26, color: '#0B1220', opacity: 0.75, lineHeight: 1.5 }}>时间 / 重复 / 类型 / 操作…逐个填</Text>
                </Box>
            </Box>
        </Box>
    </Box>
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 22, color: '#0B1220', opacity: 0.4 }}>知歇 ZhiXie · V1.0.0</Text>
        <Text style={{ fontSize: 22, fontFamily: 'Consolas', color: '#0B1220', opacity: 0.4 }}>32 / 38</Text>
