<Slide style={{ width: 1280, height: 720, background: '#F5F9FC', padding: '20px 64px' }}>
    <Box style={{ height: 124, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between', paddingBottom: 16 }}>
        <Box style={{ flexDirection: 'column', gap: 4 }}>
            <Text style={{ fontSize: 46, fontWeight: 'bold', color: '#0B1220' }}>身体先扛不住的，是眼睛和脖子</Text>
            <Text style={{ fontSize: 28, color: '#0B1220', opacity: 0.6, letterSpacing: 1 }}>久坐办公人群，一天里最缺的就是"停一下"</Text>
