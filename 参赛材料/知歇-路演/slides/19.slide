<Slide style={{ width: 1280, height: 720, background: '#F5F9FC', padding: '20px 64px' }}>
    <Box style={{ height: 124, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between', paddingBottom: 16 }}>
        <Box style={{ flexDirection: 'column', gap: 4 }}>
            <Text style={{ fontSize: 46, fontWeight: 'bold', color: '#0B1220' }}>模型选型：选谁、怎么换</Text>
            <Text style={{ fontSize: 28, color: '#0B1220', opacity: 0.6, letterSpacing: 1 }}>不绑定一家，改两格就能换</Text>
        </Box>
        <Text style={{ fontSize: 22, fontFamily: 'Consolas', color: '#0B1220', opacity: 0.35 }}>19</Text>
    </Box>
    <Box style={{ height: 476, flexDirection: 'row', gap: 40, alignItems: 'center' }}>
        <Box style={{ flex: 1, flexDirection: 'column', gap: 18, justifyContent: 'center' }}>
            <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#0D9488', lineHeight: 1.4 }}>不绑定某一家。</Text>
            <Text style={{ fontSize: 28, color: '#0B1220', opacity: 0.8, lineHeight: 1.5 }}>云端地址、模型名、密钥，三格配置。</Text>
            <Text style={{ fontSize: 28, color: '#0B1220', opacity: 0.8, lineHeight: 1.5 }}>想换 DeepSeek / 通义 / 本地模型，改一下就行。</Text>
            <Box style={{ padding: '18px 22px', background: 'rgba(79,224,176,0.16)', border: '1px solid rgba(13,148,136,0.35)', borderRadius: 12 }}>
                <Text style={{ fontSize: 28, color: '#0B1220', lineHeight: 1.5 }}>换模型 = <span style={{ color: '#0D9488', fontWeight: 'bold' }}>改配置，不重写</span></Text>
            </Box>
        </Box>
        <Box style={{ width: 560, height: 420, flexDirection: 'column', gap: 16, padding: '28px 30px', background: '#FFFFFF', border: '1px solid rgba(11,18,32,0.10)', borderRadius: 12, justifyContent: 'center' }}>
            <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#0D9488' }}>配置（三格）</Text>
            <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', padding: '14px 0', borderBottom: '1px solid rgba(11,18,32,0.08)' }}>
                <Text style={{ fontSize: 26, color: '#0B1220', opacity: 0.6 }}>服务商</Text>
                <Text style={{ fontSize: 28, fontWeight: 'bold', color: '#0B1220' }}>DeepSeek（可改）</Text>
            </Box>
            <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', padding: '14px 0', borderBottom: '1px solid rgba(11,18,32,0.08)' }}>
                <Text style={{ fontSize: 26, color: '#0B1220', opacity: 0.6 }}>接口地址</Text>
                <Text style={{ fontSize: 26, color: '#0B1220' }}>/v1/chat/completions</Text>
            </Box>
            <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', padding: '14px 0' }}>
                <Text style={{ fontSize: 26, color: '#0B1220', opacity: 0.6 }}>密钥</Text>
                <Text style={{ fontSize: 26, color: '#0B1220' }}>sk-****（本地保存）</Text>
            </Box>
        </Box>
    </Box>
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 22, color: '#0B1220', opacity: 0.4 }}>知歇 ZhiXie · V1.0.0</Text>
        <Text style={{ fontSize: 22, fontFamily: 'Consolas', color: '#0B1220', opacity: 0.4 }}>19 / 38</Text>
    </Box>
</Slide>
