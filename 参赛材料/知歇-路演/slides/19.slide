<Slide style={{ width: 1280, height: 720, background: '#0B1220', padding: '20px 64px' }}>
    <Box style={{ height: 124, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between', paddingBottom: 16 }}>
        <Box style={{ flexDirection: 'column', gap: 4 }}>
            <Text style={{ fontSize: 46, fontWeight: 'bold', color: '#E8EEF7' }}>用 138 项检查把代码兜住</Text>
            <Text style={{ fontSize: 28, color: '#E8EEF7', opacity: 0.6, letterSpacing: 1 }}>每改一次自动跑一遍，有一项不过就不算完</Text>
        </Box>
        <Text style={{ fontSize: 22, fontFamily: 'Consolas', color: '#4FE0B0', opacity: 0.8 }}>AI 开发</Text>
    </Box>
    <Box style={{ height: 476, flexDirection: 'row', gap: 40, alignItems: 'center' }}>
        <Box style={{ flex: 1, flexDirection: 'column', gap: 16 }}>
            <Box style={{ height: 112, flexDirection: 'column', justifyContent: 'center', gap: 8, padding: '0 22px', background: 'rgba(232,238,247,0.04)', border: '1px solid rgba(232,238,247,0.10)', borderRadius: 12 }}>
                <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#4FE0B0' }}>常规检查</Text>
                <Text style={{ fontSize: 26, color: '#E8EEF7', opacity: 0.78, lineHeight: 1.5 }}>界面逻辑和核心逻辑分开跑，每次改动全量重跑。</Text>
            </Box>
            <Box style={{ height: 112, flexDirection: 'column', justifyContent: 'center', gap: 8, padding: '0 22px', background: 'rgba(232,238,247,0.04)', border: '1px solid rgba(232,238,247,0.10)', borderRadius: 12 }}>
                <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#4FE0B0' }}>故意喂脏数据</Text>
                <Text style={{ fontSize: 26, color: '#E8EEF7', opacity: 0.78, lineHeight: 1.5 }}>构造一堆乱七八糟的字段，验证它们全被挡下。</Text>
            </Box>
            <Box style={{ height: 112, flexDirection: 'column', justifyContent: 'center', gap: 8, padding: '0 22px', background: 'rgba(232,238,247,0.04)', border: '1px solid rgba(232,238,247,0.10)', borderRadius: 12 }}>
                <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#4FE0B0' }}>改完就回归</Text>
                <Text style={{ fontSize: 26, color: '#E8EEF7', opacity: 0.78, lineHeight: 1.5 }}>修一个 bug 就补一条测试，防止下次又坏回去。</Text>
            </Box>
            <Box style={{ padding: '14px 22px', background: 'rgba(79,224,176,0.10)', borderRadius: 12 }}>
                <Text style={{ fontSize: 28, color: '#E8EEF7', lineHeight: 1.5 }}>AI 写得快，但<span style={{ color: '#4FE0B0', fontWeight: 'bold' }}>敢不敢用，是测试说了算</span>。</Text>
            </Box>
        </Box>
        <Box style={{ width: 460, flexDirection: 'column', gap: 14 }}>
            <Box style={{ height: 300, flexDirection: 'column', justifyContent: 'center', alignItems: 'center', gap: 10, background: 'rgba(79,224,176,0.05)', border: '2px dashed rgba(79,224,176,0.55)', borderRadius: 14, padding: '0 20px' }}>
                <Text style={{ fontSize: 22, fontFamily: 'Consolas', color: '#4FE0B0', letterSpacing: 1 }}>截图 ⑱</Text>
                <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#E8EEF7', textAlign: 'center' }}>测试通过截图</Text>
                <Text style={{ fontSize: 22, color: '#E8EEF7', opacity: 0.5, textAlign: 'center', lineHeight: 1.7 }}>建议画面：pnpm test / cargo test 的<br />通过结果，或 CI 构建成功页</Text>
            </Box>
            <Box style={{ flexDirection: 'row', gap: 10 }}>
                <Box style={{ flex: 1, padding: '14px 8px', background: 'rgba(79,224,176,0.10)', borderRadius: 10, alignItems: 'center' }}>
                    <Text style={{ fontSize: 22, color: '#E8EEF7', opacity: 0.9, textAlign: 'center' }}>界面 77 项</Text>
                </Box>
                <Box style={{ flex: 1, padding: '14px 8px', background: 'rgba(79,224,176,0.10)', borderRadius: 10, alignItems: 'center' }}>
                    <Text style={{ fontSize: 22, color: '#E8EEF7', opacity: 0.9, textAlign: 'center' }}>核心 61 项</Text>
                </Box>
                <Box style={{ flex: 1, padding: '14px 8px', background: 'rgba(79,224,176,0.10)', borderRadius: 10, alignItems: 'center' }}>
                    <Text style={{ fontSize: 22, color: '#E8EEF7', opacity: 0.9, textAlign: 'center' }}>通过率 100%</Text>
                </Box>
            </Box>
        </Box>
    </Box>
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 22, color: '#E8EEF7', opacity: 0.45 }}>知歇 ZhiXie · V1.0.0</Text>
        <Text style={{ fontSize: 22, fontFamily: 'Consolas', color: '#E8EEF7', opacity: 0.45 }}>19 / 30</Text>
    </Box>
</Slide>
