<Slide style={{ width: 1280, height: 720, background: '#0B1220', padding: '20px 64px' }}>
    <Box style={{ height: 124, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between', paddingBottom: 16 }}>
        <Box style={{ flexDirection: 'column', gap: 4 }}>
            <Text style={{ fontSize: 46, fontWeight: 'bold', color: '#E8EEF7' }}>演示三 · 到点全屏弹窗</Text>
            <Text style={{ fontSize: 28, color: '#E8EEF7', opacity: 0.6, letterSpacing: 1 }}>不是角落里的小通知，是整屏挡一下</Text>
        </Box>
        <Text style={{ fontSize: 22, fontFamily: 'Consolas', color: '#4FE0B0', opacity: 0.8 }}>成品演示</Text>
    </Box>
    <Box style={{ height: 476, flexDirection: 'row', gap: 36, alignItems: 'center' }}>
        <Box style={{ width: 660, height: 440, flexDirection: 'column', justifyContent: 'center', alignItems: 'center', gap: 12, background: 'rgba(79,224,176,0.05)', border: '2px dashed rgba(79,224,176,0.55)', borderRadius: 14, padding: '0 20px' }}>
            <Text style={{ fontSize: 22, fontFamily: 'Consolas', color: '#4FE0B0', letterSpacing: 1 }}>截图 ⑨</Text>
            <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#E8EEF7', textAlign: 'center' }}>全屏休息弹窗</Text>
            <Text style={{ fontSize: 22, color: '#E8EEF7', opacity: 0.5, textAlign: 'center', lineHeight: 1.7 }}>建议画面：底图 + 正中间那句提示语<br />+ 「稍后提醒」按钮</Text>
        </Box>
        <Box style={{ flex: 1, flexDirection: 'column', gap: 12 }}>
            <Box style={{ flexDirection: 'column', gap: 10, padding: '16px 22px', background: 'rgba(232,238,247,0.04)', border: '1px solid rgba(232,238,247,0.10)', borderRadius: 12 }}>
                <Text style={{ fontSize: 28, fontWeight: 'bold', color: '#4FE0B0' }}>弹的是你自己的话</Text>
                <Text style={{ fontSize: 28, color: '#E8EEF7', opacity: 0.78, lineHeight: 1.5 }}>底图、配色、字号都能换，改的时候能实时预览。</Text>
            </Box>
            <Box style={{ flexDirection: 'column', gap: 10, padding: '18px 22px', background: 'rgba(232,238,247,0.04)', border: '1px solid rgba(232,238,247,0.10)', borderRadius: 12 }}>
                <Text style={{ fontSize: 28, fontWeight: 'bold', color: '#4FE0B0' }}>两个选择</Text>
                <Text style={{ fontSize: 28, color: '#E8EEF7', opacity: 0.78, lineHeight: 1.5 }}>「稍后提醒」，或直接结束这次休息。</Text>
            </Box>
            <Box style={{ padding: '14px 22px', background: 'rgba(79,224,176,0.10)', borderRadius: 12 }}>
                <Text style={{ fontSize: 28, color: '#E8EEF7', lineHeight: 1.5 }}>关掉后缩回托盘继续计时。</Text>
            </Box>
        </Box>
    </Box>
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 22, color: '#E8EEF7', opacity: 0.45 }}>知歇 ZhiXie · V1.0.0</Text>
        <Text style={{ fontSize: 22, fontFamily: 'Consolas', color: '#E8EEF7', opacity: 0.45 }}>23 / 30</Text>
