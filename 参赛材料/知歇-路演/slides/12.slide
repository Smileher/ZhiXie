<Slide style={{ width: 1280, height: 720, background: '#0B1220', padding: '20px 64px' }}>
    <Box style={{ height: 124, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between', paddingBottom: 16 }}>
        <Box style={{ flexDirection: 'column', gap: 4 }}>
            <Text style={{ fontSize: 46, fontWeight: 'bold', color: '#E8EEF7' }}>通道二：没网时用自带规则</Text>
            <Text style={{ fontSize: 28, color: '#E8EEF7', opacity: 0.6, letterSpacing: 1 }}>软件自己带了一套规则，断网照样听懂</Text>
        </Box>
        <Text style={{ fontSize: 22, fontFamily: 'Consolas', color: '#E8EEF7', opacity: 0.35 }}>12</Text>
    </Box>
    <Box style={{ height: 476, flexDirection: 'row', gap: 36 }}>
        <Box style={{ flex: 1, flexDirection: 'column', gap: 8 }}>
            <Box style={{ height: 34, flexDirection: 'row', alignItems: 'center' }}>
                <Text style={{ width: 380, fontSize: 24, color: '#E8EEF7', opacity: 0.5 }}>你说的（日常口语）</Text>
                <Text style={{ flex: 1, fontSize: 24, color: '#E8EEF7', opacity: 0.5 }}>软件理解成</Text>
            </Box>
            <Box style={{ height: 56, flexDirection: 'row', alignItems: 'center', padding: '0 18px', background: 'rgba(232,238,247,0.04)', border: '1px solid rgba(232,238,247,0.10)', borderRadius: 10 }}>
                <Text style={{ width: 380, fontSize: 28, color: '#E8EEF7' }}>「每天下午三点提醒我喝水」</Text>
                <Text style={{ flex: 1, fontSize: 28, color: '#4FE0B0' }}>每天 · 15:00</Text>
            </Box>
            <Box style={{ height: 56, flexDirection: 'row', alignItems: 'center', padding: '0 18px', background: 'rgba(232,238,247,0.04)', border: '1px solid rgba(232,238,247,0.10)', borderRadius: 10 }}>
                <Text style={{ width: 380, fontSize: 28, color: '#E8EEF7' }}>「30分钟后提醒我接水」</Text>
                <Text style={{ flex: 1, fontSize: 28, color: '#4FE0B0' }}>一次 · 30 分钟后</Text>
            </Box>
            <Box style={{ height: 56, flexDirection: 'row', alignItems: 'center', padding: '0 18px', background: 'rgba(232,238,247,0.04)', border: '1px solid rgba(232,238,247,0.10)', borderRadius: 10 }}>
                <Text style={{ width: 380, fontSize: 28, color: '#E8EEF7' }}>「每周一三五 17:30 锁屏」</Text>
                <Text style={{ flex: 1, fontSize: 28, color: '#4FE0B0' }}>每周一 / 三 / 五 · 锁屏</Text>
            </Box>
            <Box style={{ height: 56, flexDirection: 'row', alignItems: 'center', padding: '0 18px', background: 'rgba(232,238,247,0.04)', border: '1px solid rgba(232,238,247,0.10)', borderRadius: 10 }}>
                <Text style={{ width: 380, fontSize: 28, color: '#E8EEF7' }}>「明天早上八点交作业」</Text>
                <Text style={{ flex: 1, fontSize: 28, color: '#4FE0B0' }}>一次 · 明天 08:00</Text>
            </Box>
            <Box style={{ height: 56, flexDirection: 'row', alignItems: 'center', padding: '0 18px', background: 'rgba(232,238,247,0.04)', border: '1px solid rgba(232,238,247,0.10)', borderRadius: 10 }}>
                <Text style={{ width: 380, fontSize: 28, color: '#E8EEF7' }}>「晚上十一点锁屏睡觉」</Text>
                <Text style={{ flex: 1, fontSize: 28, color: '#4FE0B0' }}>每天 · 23:00 · 锁屏</Text>
            </Box>
            <Box style={{ marginTop: 4, padding: '12px 20px', background: 'rgba(79,224,176,0.10)', borderRadius: 10 }}>
                <Text style={{ fontSize: 26, color: '#E8EEF7', opacity: 0.9, lineHeight: 1.5 }}>实在没听懂，就当成一次提醒，把你的原话留作标题。</Text>
            </Box>
        </Box>
        <Box style={{ width: 400, flexDirection: 'column', gap: 14 }}>
            <Box style={{ height: 250, flexDirection: 'column', justifyContent: 'center', alignItems: 'center', gap: 10, background: 'rgba(79,224,176,0.05)', border: '2px dashed rgba(79,224,176,0.55)', borderRadius: 12, padding: '0 18px' }}>
                <Text style={{ fontSize: 22, fontFamily: 'Consolas', color: '#4FE0B0', letterSpacing: 1 }}>截图 ⑳</Text>
