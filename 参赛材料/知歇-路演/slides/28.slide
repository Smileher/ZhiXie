<Slide style={{ width: 1280, height: 720, background: '#0B1220', padding: '20px 64px' }}>
    <Box style={{ height: 124, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between', paddingBottom: 16 }}>
        <Box style={{ flexDirection: 'column', gap: 4 }}>
            <Text style={{ fontSize: 46, fontWeight: 'bold', color: '#E8EEF7' }}>五个不一样的地方</Text>
            <Text style={{ fontSize: 28, color: '#E8EEF7', opacity: 0.6, letterSpacing: 1 }}>每条都对应一个看得见的动作，不是说法</Text>
        </Box>
        <Text style={{ fontSize: 22, fontFamily: 'Consolas', color: '#4FE0B0', opacity: 0.8 }}>创新点</Text>
    </Box>
    <Box style={{ height: 476, flexDirection: 'column', gap: 10 }}>
        <Box style={{ height: 86, flexDirection: 'row', alignItems: 'center', gap: 24, padding: '0 24px', background: 'rgba(232,238,247,0.04)', border: '1px solid rgba(232,238,247,0.10)', borderRadius: 12 }}>
            <Text style={{ fontSize: 48, fontWeight: 'bold', fontFamily: 'Consolas', color: '#4FE0B0', lineHeight: 1 }}>01</Text>
            <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#E8EEF7', width: 420 }}>说一句话就把提醒设好</Text>
            <Text style={{ fontSize: 26, color: '#E8EEF7', opacity: 0.72, flex: 1 }}>不用点一堆表单，也不用先学一套说法。</Text>
        </Box>
        <Box style={{ height: 86, flexDirection: 'row', alignItems: 'center', gap: 24, padding: '0 24px', background: 'rgba(232,238,247,0.04)', border: '1px solid rgba(232,238,247,0.10)', borderRadius: 12 }}>
            <Text style={{ fontSize: 48, fontWeight: 'bold', fontFamily: 'Consolas', color: '#4FE0B0', lineHeight: 1 }}>02</Text>
            <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#E8EEF7', width: 420 }}>没网也能听懂你</Text>
            <Text style={{ fontSize: 26, color: '#E8EEF7', opacity: 0.72, flex: 1 }}>软件自带一套规则，断网照样解析。</Text>
        </Box>
        <Box style={{ height: 86, flexDirection: 'row', alignItems: 'center', gap: 24, padding: '0 24px', background: 'rgba(232,238,247,0.04)', border: '1px solid rgba(232,238,247,0.10)', borderRadius: 12 }}>
            <Text style={{ fontSize: 48, fontWeight: 'bold', fontFamily: 'Consolas', color: '#4FE0B0', lineHeight: 1 }}>03</Text>
            <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#E8EEF7', width: 420 }}>AI 说的会先核一遍</Text>
            <Text style={{ fontSize: 26, color: '#E8EEF7', opacity: 0.72, flex: 1 }}>不合规的内容写不进你的提醒列表。</Text>
        </Box>
        <Box style={{ height: 86, flexDirection: 'row', alignItems: 'center', gap: 24, padding: '0 24px', background: 'rgba(232,238,247,0.04)', border: '1px solid rgba(232,238,247,0.10)', borderRadius: 12 }}>
            <Text style={{ fontSize: 48, fontWeight: 'bold', fontFamily: 'Consolas', color: '#4FE0B0', lineHeight: 1 }}>04</Text>
            <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#E8EEF7', width: 420 }}>一个人 + AI 助手做出来的</Text>
            <Text style={{ fontSize: 26, color: '#E8EEF7', opacity: 0.72, flex: 1 }}>想法结构自己定，AI 写代码，138 项检查兜底。</Text>
        </Box>
        <Box style={{ height: 86, flexDirection: 'row', alignItems: 'center', gap: 24, padding: '0 24px', background: 'rgba(232,238,247,0.04)', border: '1px solid rgba(232,238,247,0.10)', borderRadius: 12 }}>
            <Text style={{ fontSize: 48, fontWeight: 'bold', fontFamily: 'Consolas', color: '#4FE0B0', lineHeight: 1 }}>05</Text>
            <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#E8EEF7', width: 420 }}>立场是让你休息</Text>
            <Text style={{ fontSize: 26, color: '#E8EEF7', opacity: 0.72, flex: 1 }}>不催你干活，不比谁更拼，文案不制造焦虑。</Text>
        </Box>
    </Box>
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 22, color: '#E8EEF7', opacity: 0.45 }}>知歇 ZhiXie · V1.0.0</Text>
        <Text style={{ fontSize: 22, fontFamily: 'Consolas', color: '#E8EEF7', opacity: 0.45 }}>28 / 30</Text>
    </Box>
</Slide>
